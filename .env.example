# Copy to .env.local (git-ignored) in the project root and fill in values from the
# Supabase Dashboard. Restart the dev server after changes. Never commit real values.

# Project URL: Dashboard > Project Settings > API (or the Connect dialog)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public client key. Prefer the publishable key (sb_publishable_...).
# If your project only has legacy keys, leave this empty and set VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# true (default): signed-out visitors can browse sample data.
# false: every app page requires sign-in and a workspace.
VITE_DEMO_MODE=true

# Never put the secret / service_role key in any VITE_ variable: those are bundled
# into browser code. No privileged key is needed for the current foundation.
